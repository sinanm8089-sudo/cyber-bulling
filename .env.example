# Cyberbullying Detection System Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini API Key (for LLM cyberbullying analysis and image vision detection)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 Key (optional, for fetching comments from YouTube videos)
# Get one at: https://console.cloud.google.com/
# Note: yt-dlp fallback is also supported without an API key!
YOUTUBE_API_KEY=your_youtube_api_key_here

# Instagram Graph API Access Token (optional, for fetching Instagram comments)
# Note: instaloader fallback is also supported without a token!
INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here
